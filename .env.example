# ============================================================================
# QuantBot environment template.  Copy to `.env` and fill in real values.
# NEVER commit a populated .env file.
# ============================================================================

# ---- Runtime ----
QUANTBOT_ENV=development            # development | staging | production
QUANTBOT_MODE=paper                 # paper | live   (live requires real creds)
LOG_LEVEL=INFO                      # DEBUG | INFO | WARNING | ERROR
LOG_JSON=true                       # emit structured JSON logs

# ---- PostgreSQL ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=quantbot
POSTGRES_USER=quantbot
POSTGRES_PASSWORD=changeme
# Optional: full URL overrides the parts above
# DATABASE_URL=postgresql+psycopg2://quantbot:changeme@localhost:5432/quantbot

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_URL=redis://localhost:6379/0

# ---- Market data source (ccxt) ----
DATA_EXCHANGE=binance               # ccxt exchange id used for OHLCV download
# Public OHLCV usually needs no keys; set these only if your venue requires them
DATA_EXCHANGE_API_KEY=
DATA_EXCHANGE_SECRET=

# ---- Risk configuration ----
RISK_PER_TRADE=0.0075               # 0.75% of equity risked per trade (0.5%-1%)
MAX_CONCURRENT_POSITIONS=5
DAILY_LOSS_LIMIT=0.03               # 3%
WEEKLY_LOSS_LIMIT=0.08              # 8%
KILL_SWITCH_DRAWDOWN=0.20           # 20% peak-to-trough halts everything

# ---- Hyperliquid integration (spot + perps; recommended for OHLCV strategies) ----
# Generate an API wallet (agent) at https://app.hyperliquid.xyz/API.
# The API-wallet key SIGNS orders but cannot withdraw. Use the MAIN wallet
# address (not the agent's) as the account address.
HYPERLIQUID_SECRET_KEY=             # API-wallet (agent) private key — KEEP SECRET
HYPERLIQUID_ACCOUNT_ADDRESS=        # MAIN wallet public address (0x...)
HYPERLIQUID_TESTNET=false           # true -> use testnet
# HYPERLIQUID_API_URL=              # optional explicit override

# ---- Bullpen integration (venue: https://bullpen.fi) ----
# NOTE: API host/paths/auth are unconfirmed placeholders — verify against the
# real Bullpen docs before live trading and adjust integrations/bullpen.py.
BULLPEN_API_KEY=
BULLPEN_API_SECRET=
BULLPEN_BASE_URL=https://api.bullpen.fi
BULLPEN_WS_URL=wss://stream.bullpen.fi
