# =============================================================================
#  TradingView -> Bybit perps execution bot
#  Copy to .env and fill in. NEVER commit the real .env.
#    chmod 600 .env
# =============================================================================

# ---- Mode -------------------------------------------------------------------
# DRY_RUN : log intended orders, place nothing. No credentials required.
# TESTNET : real API calls against Bybit testnet. This is the default.
# LIVE    : real money. Also requires LIVE_CONFIRM below.
MODE=TESTNET

# Required verbatim when MODE=LIVE. The server refuses to start without it.
LIVE_CONFIRM=

# ---- Bybit credentials ------------------------------------------------------
# Testnet keys: https://testnet.bybit.com/app/user/api-management
# Mainnet keys: https://www.bybit.com/app/user/api-management
# Permissions needed: Contract - Orders + Positions, and Wallet read.
# DO NOT enable withdrawal permission. Bind the key to your VPS IP.
BYBIT_API_KEY=
BYBIT_API_SECRET=

# ---- Webhook security -------------------------------------------------------
# Long random string. Generate with:  openssl rand -hex 32
# This is transport auth only - TradingView cannot sign requests, so treat TLS
# and the IP allowlist as the real perimeter.
WEBHOOK_SECRET=

# Restrict callers to TradingView's published webhook source addresses.
IP_ALLOWLIST_ENABLED=true
IP_ALLOWLIST=52.89.214.238,34.212.75.30,54.218.53.128,52.32.178.7

# Only enable if the bot sits behind a reverse proxy you control. When false,
# X-Forwarded-For is ignored so it cannot be spoofed past the allowlist.
TRUST_PROXY_HEADERS=false

# ---- Instruments ------------------------------------------------------------
# TradingView ticker = ccxt unified symbol, comma separated.
SYMBOL_MAP=BTCUSDT.P=BTC/USDT:USDT,ETHUSDT.P=ETH/USDT:USDT

# Signals on any other resolution are refused.
EXPECTED_TIMEFRAME=60

# ---- Sizing and risk --------------------------------------------------------
RISK_PCT=0.005                # 0.5% of equity risked per trade
MAX_LEVERAGE=3.0
MAX_POSITIONS_TOTAL=2
MAX_POSITIONS_PER_SYMBOL=1

# Accepted reward:risk band. Anything outside means a malformed or edited alert.
RR_MIN=2.9
RR_MAX=3.1

# Volatility-regime gate, re-checked server-side. The 0.4% floor is what bounds
# implied leverage: risk% / stop% = 0.5 / 0.4 = 1.25x.
STOP_DIST_MIN_PCT=0.004
STOP_DIST_MAX_PCT=0.03

# ---- Kill switches ----------------------------------------------------------
DAILY_LOSS_LIMIT_PCT=0.03     # halt new entries for the UTC day at -3% equity
MAX_CONSECUTIVE_LOSSES=5
HALT_FILE=./HALT              # `touch HALT` stops new entries immediately
HALT=false                    # env equivalent of the HALT file

# ---- Execution timing -------------------------------------------------------
# Age limit measured from the signal bar's CLOSE, not its open. 90s is tight;
# raise to 120-180 if you see legitimate signals rejected as stale under load.
MAX_SIGNAL_AGE_SEC=90

ENTRY_FILL_TIMEOUT_SEC=45     # unfilled after this -> cancel, do not chase
ENTRY_POLL_INTERVAL_SEC=1.0
MAX_SLIPPAGE_PCT=0.0015       # 0.15% worst-price bound on entry
RECONCILE_INTERVAL_SEC=30

# ---- Exchange resilience ----------------------------------------------------
RETRY_ATTEMPTS=5
RETRY_BASE_DELAY_SEC=0.5
RETRY_MAX_DELAY_SEC=20.0

# ---- Persistence and logging ------------------------------------------------
DB_PATH=./data/tradingbot.sqlite3
LOG_FILE=./logs/tradingbot.jsonl
LOG_LEVEL=INFO

# ---- Notifications ----------------------------------------------------------
# Create a bot with @BotFather, then message it and read your chat id from
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFY_DEDUP_SEC=300

# ---- DRY_RUN ----------------------------------------------------------------
DRY_RUN_EQUITY=10000

# ---- Server -----------------------------------------------------------------
# Bind to loopback and terminate TLS in front of it (Cloudflare Tunnel or nginx).
# Never expose this port directly.
HOST=127.0.0.1
PORT=8000
