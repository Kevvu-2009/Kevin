//@version=6
// QuantBot example strategy for TradingView webhooks.
// EMA trend cross, long-only, with an ATR stop and a fixed reward:risk target.
//
// Alert setup: Create alert -> Condition: this strategy -> "Order fills only"
//   Message:      {{strategy.order.alert_message}}
//   Webhook URL:  https://<your-host>/webhook/tradingview
//
// Keep this script PRIVATE: the webhook secret is sent from the input below.
strategy("QuantBot EMA/ATR", overlay = true, initial_capital = 10000,
     default_qty_type = strategy.percent_of_equity, default_qty_value = 100,
     commission_type = strategy.commission.percent, commission_value = 0.05)

secret   = input.string("CHANGE_ME", "Webhook secret (TRADINGVIEW_WEBHOOK_SECRET)")
fastLen  = input.int(20, "Fast EMA", minval = 1)
slowLen  = input.int(50, "Slow EMA", minval = 2)
atrLen   = input.int(14, "ATR length", minval = 1)
atrMult  = input.float(2.5, "Stop = ATR x", minval = 0.1, step = 0.1)
rr       = input.float(2.0, "Take profit = risk x", minval = 0.1, step = 0.1)

fast = ta.ema(close, fastLen)
slow = ta.ema(close, slowLen)
atr  = ta.atr(atrLen)

plot(fast, "Fast EMA", color.teal)
plot(slow, "Slow EMA", color.orange)

msg(action, stopPx, tpPx) =>
    '{"secret":"' + secret + '","action":"' + action + '","symbol":"' + syminfo.ticker +
     '","price":' + str.tostring(close) +
     (na(stopPx) ? "" : ',"stop":' + str.tostring(stopPx)) +
     (na(tpPx) ? "" : ',"take_profit":' + str.tostring(tpPx)) +
     ',"strategy":"ema_atr","id":"' + str.tostring(time) + '-' + action + '"}'

longEntry = ta.crossover(fast, slow) and barstate.isconfirmed
longExit  = ta.crossunder(fast, slow) and barstate.isconfirmed

var float stopPx = na
var float tpPx   = na

if longEntry and strategy.position_size == 0
    stopPx := close - atr * atrMult
    tpPx   := close + (close - stopPx) * rr
    strategy.entry("L", strategy.long, alert_message = msg("buy", stopPx, tpPx))

if strategy.position_size > 0
    strategy.exit("L-exit", "L", stop = stopPx, limit = tpPx,
         alert_message = msg("sell", na, na))

if longExit and strategy.position_size > 0
    strategy.close("L", alert_message = msg("sell", na, na))

plot(strategy.position_size > 0 ? stopPx : na, "Stop", color.red, style = plot.style_linebr)
plot(strategy.position_size > 0 ? tpPx : na, "Target", color.green, style = plot.style_linebr)
